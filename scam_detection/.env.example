# Copy to .env and fill in. .env is gitignored - never commit real keys.

# STT backend: "local" (faster-whisper on this machine) or "groq" (hosted API)
STT_BACKEND=local

# Required when STT_BACKEND=groq. Get one at https://console.groq.com
GROQ_API_KEY=

# Optional. whisper-large-v3 (default) is the most accurate on Urdu.
# whisper-large-v3-turbo is faster but weaker on non-English audio.
# GROQ_STT_MODEL=whisper-large-v3

# Optional: force a transcription language (e.g. ur, en). Empty = auto-detect.
# GROQ_LANGUAGE=

# Optional: Whisper often labels Pakistani Urdu as Hindi and returns Devanagari,
# which the classifier was not trained on. true re-transcribes those as Urdu.
# GROQ_RETRY_HINDI_AS_URDU=true

# Optional: set false to disable the audio endpoint entirely
# ENABLE_AUDIO=true
